# Copie para .env apenas se for rodar o app localmente (npm run dev).
# Em produção (Vercel), cadastre estas variáveis no painel do projeto.
#
# ATENCAO: o repositorio e publico. Nunca commite o .env de verdade.
# A chave service_role da acesso total ao banco: mantenha so no servidor,
# sem prefixo VITE_ (prefixo VITE_ vai para o navegador e expoe a chave).

# URL do seu projeto Supabase (Settings -> API -> Project URL)
SUPABASE_URL=

# Chave service_role do seu projeto Supabase (Settings -> API -> service_role)
# SOMENTE servidor. Nunca use VITE_SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
